package org.sample.model {

    import jakarta.validation.constraints.NotNull
    import jakarta.validation.constraints.Size


    #Serializable(1)
    #Enum ContactType {
        #Values(BUSINESS = 1,HOME = 0)
        #Attr Integer value
    }

    #Serializable(1)
    #Enum PersonGender {
        #Values(FEMALE = "F",MALE = "M")
        #Attr String value
    }

    #Operators #Serializable(1) #Equals(id) #HashCode(id) #ToString(id,type,address,phoneNumber)
    #Pojo Contact {
        #PrimaryKey #Index
        #Attr java.math.BigInteger id
        @NotNull
        #ToInit #Required #IsPojo
        #Attr Person person
        @NotNull
        #Required
        #Attr ContactType type
        @Size(max = 100)
        #IsDef
        #Attr String address
        @Size(max = 100)
        #IsDef
        #Attr String phoneNumber
    }

    #Operators #Serializable(1) #Equals(id) #HashCode(id) #ToString(id,firstName,lastName,dateOfBirth,gender,ssn)
    #Pojo Person {
        #PrimaryKey #Index
        #Attr java.math.BigInteger id
        @NotNull
        @Size(max = 100)
        #Required
        #Attr String firstName
        @NotNull
        @Size(max = 100)
        #Required #Index
        #Attr String lastName
        #IsDef
        #Attr java.time.LocalDateTime dateOfBirth
        @NotNull
        #Required
        #Attr PersonGender gender
        @Size(max = 100)
        #IsDef
        #Attr String ssn
        #ToInit
        #Attr java.util.List <Contact> contacts
    }

    #Serializable(1) #ToString(t)
    #Pojo AnHourBefore {
        #Attr java.time.LocalDateTime t
    }

    #Serializable(1) #ToString(newid,dateOfBirth,ssn,firstName,lastName,gender)
    #Pojo NewPerson {
        #Attr java.math.BigDecimal newid
        #Attr java.time.LocalDateTime dateOfBirth
        #Attr String ssn
        #Attr String firstName
        #Attr String lastName
        #Attr String gender
    }

    #Serializable(1) #ToString(resultCur,dateOfBirth,ssn,firstName,lastName,gender)
    #Pojo NewPersonOutRs {
        #Attr Object resultCur
        #Attr java.time.LocalDateTime dateOfBirth
        #Attr String ssn
        #Attr String firstName
        #Attr String lastName
        #Attr String gender
    }

    #Serializable(1) #ToString(dateOfBirth,ssn,firstName,lastName,gender)
    #Pojo NewPersonRetRs {
        #Attr java.time.LocalDateTime dateOfBirth
        #Attr String ssn
        #Attr String firstName
        #Attr String lastName
        #Attr String gender
    }
}