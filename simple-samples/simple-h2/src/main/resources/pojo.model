package org.sample.model {

    import jakarta.validation.constraints.NotNull
    import jakarta.validation.constraints.Size


    #Operators #Serializable(1) #ToString(result) #ProcId(result)
    #Pojo AnHourBeforeResult {
        #IsDef
        #Attr java.time.LocalDateTime result // TIMESTAMP(29)
    }

    #Operators #Serializable(1) #Equals(idContact) #HashCode(idContact) #ToString(idContact,type,address,phoneNumber,xNote) #ProcId(idContact,person,type,address,phoneNumber,xNote)
    // The contact information
    #Pojo Contact {
        #PrimaryKey() #Index
        // The technical primary key
        #Attr Long idContact // BIGINT(64)
        @NotNull
        #ToInit #Required #Index #IsPojo
        // The owner of this contact
        #Attr Person person // BIGINT(64)
        @NotNull
        #Required
        // The contact type: 0=home, 1=business, 2=abroad
        #Attr Integer type // INTEGER(32)
        @NotNull
        @Size(max = 100)
        #Required
        // The address: city, street...
        #Attr String address // CHARACTER VARYING(100)
        @Size(max = 100)
        #IsDef
        // The phone number
        #Attr String phoneNumber // CHARACTER VARYING(100)
        @Size(max = 100)
        #IsDef
        // Any notes and remarks
        #Attr String xNote // CHARACTER VARYING(100)
        #Attr boolean onlyIds_
        #Attr java.util.List <Long> ids_
    }

    #Operators #Serializable(1) #Equals(idPerson) #HashCode(idPerson) #ToString(idPerson,firstName,lastName,dateOfBirth,gender,ssn) #ProcId(idPerson,firstName,lastName,dateOfBirth,gender,ssn)
    // The personal information
    #Pojo Person {
        #PrimaryKey() #Index
        // The technical primary key
        #Attr Long idPerson // BIGINT(64)
        @NotNull
        @Size(max = 100)
        #Required
        // The first name
        #Attr String firstName // CHARACTER VARYING(100)
        @NotNull
        @Size(max = 100)
        #Required #Index
        // The surname
        #Attr String lastName // CHARACTER VARYING(100)
        #IsDef
        // The date of birth
        #Attr java.time.LocalDate dateOfBirth // DATE(10)
        @NotNull
        @Size(max = 1)
        #Required
        // The gender: M=male, F=female, 0=other
        #Attr String gender // CHARACTER VARYING(1)
        @Size(max = 100)
        #IsDef
        // The social security number
        #Attr String ssn // CHARACTER VARYING(100)
        #ToInit
        #Attr java.util.List <Contact> contacts // null
        #ToInit
        #Attr java.util.List <PersonDetail> personDetails // null
        #Attr boolean onlyIds_
        #Attr java.util.List <Long> ids_
    }

    #Operators #Serializable(1) #ToString(type,weight,height,disposition,titles) #ProcId(person,type,weight,height,disposition,titles)
    // The detailed personal information
    #Pojo PersonDetail {
        @NotNull
        #ToInit #Required #Index #IsPojo
        // The technical primary key
        #Attr Person person // BIGINT(64)
        @NotNull
        #Required
        #Attr Integer type // INTEGER(32)
        #IsDef
        // The weight
        #Attr Integer weight // INTEGER(32)
        #IsDef
        // The height
        #Attr Integer height // INTEGER(32)
        @Size(max = 200)
        #IsDef
        // The character
        #Attr String disposition // CHARACTER VARYING(200)
        @Size(max = 100)
        #IsDef
        // The titles
        #Attr String titles // CHARACTER VARYING(100)
    }

    #Operators #Serializable(1) #Equals(id) #HashCode(id) #ToString(id,tUuid,tOffsetDateTime) #ProcId(id,tUuid,tOffsetDateTime)
    #Pojo TypesExt {
        #PrimaryKey() #Index
        #Attr Long id // BIGINT(64)
        #IsDef
        #Attr java.util.UUID tUuid // UUID(16)
        #IsDef
        #Attr java.time.OffsetDateTime tOffsetDateTime // TIMESTAMP WITH TIME ZONE(32)
        #Attr boolean onlyIds_
        #Attr java.util.List <Long> ids_
    }

    #Operators #Serializable(1) #Equals(id) #HashCode(id) #ToString(id,myid,name,description) #ProcId(id,myid,name,description)
    #Pojo UuidEntity {
        #PrimaryKey() #Index
        #Attr java.util.UUID id // UUID(16)
        @NotNull
        #Required
        #Attr java.util.UUID myid // UUID(16)
        @NotNull
        @Size(max = 100)
        #Required
        #Attr String name // CHARACTER VARYING(100)
        @Size(max = 500)
        #IsDef
        #Attr String description // CHARACTER VARYING(500)
        #Attr boolean onlyIds_
        #Attr java.util.List <java.util.UUID> ids_
    }

    #Serializable(1) #ToString(p1)
    #Pojo AnHourBefore {
        #Attr java.time.LocalDateTime p1 // TIMESTAMP(29)
    }
}